<?xml version="1.0" encoding="utf-8"?>
<!-- Today: the day and how far along it is, + to add a task, then what's left
     of it on a timeline, from the now line on. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/t_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/operarius_widget_bg"
  android:orientation="vertical"
  android:paddingLeft="12dp"
  android:paddingTop="12dp"
  android:paddingRight="12dp"
  android:paddingBottom="6dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="4dp">

    <LinearLayout
      android:id="@+id/t_head"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/t_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#F4F4F6"
        android:textSize="17sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/t_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#8A8A92"
        android:textSize="12sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/t_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginRight="10dp"
      android:gravity="end"
      android:includeFontPadding="false"
      android:singleLine="true"
      android:textColor="#C8C8CE"
      android:textSize="12sp"
      android:textStyle="bold" />

    <ImageView
      android:id="@+id/t_add"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:background="@drawable/operarius_widget_plus_bg"
      android:contentDescription="@string/operarius_widget_add"
      android:padding="9dp"
      android:src="@drawable/operarius_widget_ic_plus" />
  </LinearLayout>

  <include
    layout="@layout/operarius_widget_today_body"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />
</LinearLayout>
