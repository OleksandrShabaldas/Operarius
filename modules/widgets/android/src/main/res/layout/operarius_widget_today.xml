<?xml version="1.0" encoding="utf-8"?>
<!-- Today's timeline: the day and progress, a + button, then the tasks in order
     with the moment "now" marked. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/t_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/operarius_widget_bg"
  android:orientation="vertical"
  android:paddingLeft="12dp"
  android:paddingTop="12dp"
  android:paddingRight="12dp"
  android:paddingBottom="6dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="4dp">

    <LinearLayout
      android:id="@+id/t_head"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/t_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#F4F4F6"
        android:textSize="17sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/t_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#8A8A92"
        android:textSize="12sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/t_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginRight="10dp"
      android:gravity="end"
      android:includeFontPadding="false"
      android:textColor="#C8C8CE"
      android:textSize="12sp"
      android:textStyle="bold" />

    <ImageView
      android:id="@+id/t_add"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="@drawable/operarius_widget_plus_bg"
      android:contentDescription="@string/operarius_widget_add"
      android:padding="9dp"
      android:src="@drawable/operarius_widget_ic_plus" />
  </LinearLayout>

  <ProgressBar
    android:id="@+id/t_bar"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:layout_marginLeft="4dp"
    android:layout_marginTop="10dp"
    android:layout_marginRight="4dp"
    android:max="100"
    android:progressDrawable="@drawable/operarius_widget_progress" />

  <LinearLayout
    android:id="@+id/t_allday"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/operarius_widget_allday"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingTop="6dp"
    android:paddingRight="10dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <ImageView
      android:layout_width="14dp"
      android:layout_height="14dp"
      android:layout_marginRight="7dp"
      android:src="@drawable/operarius_widget_ic_sun" />

    <TextView
      android:id="@+id/t_allday_txt"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:singleLine="true"
      android:textColor="#C8C8CE"
      android:textSize="12.5sp" />
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1">

    <ListView
      android:id="@+id/t_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="@null"
      android:dividerHeight="0dp"
      android:scrollbars="none" />

    <LinearLayout
      android:id="@+id/t_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:orientation="vertical">

      <TextView
        android:id="@+id/t_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/operarius_widget_empty"
        android:textColor="#C8C8CE"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/t_empty_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/operarius_widget_empty_sub"
        android:textColor="#8A8A92"
        android:textSize="12sp" />
    </LinearLayout>
  </FrameLayout>
</LinearLayout>
