<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview (Android 12+): Today & Month, showing Today. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/operarius_widget_bg"
  android:orientation="vertical"
  android:paddingLeft="12dp"
  android:paddingTop="12dp"
  android:paddingRight="12dp"
  android:paddingBottom="6dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
      android:layout_width="146dp"
      android:layout_height="30dp"
      android:background="@drawable/operarius_widget_seg_track"
      android:padding="3dp">

      <ImageView
        android:layout_width="70dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/operarius_widget_seg_on" />

      <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="horizontal">

      <FrameLayout
        android:layout_width="70dp"
        android:layout_height="match_parent">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:drawableStart="@drawable/operarius_widget_ic_seg_today"
          android:drawablePadding="5dp"
          android:drawableTint="#F4F4F6"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="Today"
          android:textColor="#F4F4F6"
          android:textSize="12sp"
          android:textStyle="bold" />
      </FrameLayout>

      <FrameLayout
        android:layout_width="70dp"
        android:layout_height="match_parent">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:drawableStart="@drawable/operarius_widget_ic_seg_month"
          android:drawablePadding="5dp"
          android:drawableTint="#8A8A92"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="Month"
          android:textColor="#8A8A92"
          android:textSize="12sp"
          android:textStyle="bold" />
      </FrameLayout>
    </LinearLayout>
    </FrameLayout>

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginRight="10dp"
      android:includeFontPadding="false"
      android:text="3 of 8"
      android:textColor="#C8C8CE"
      android:textSize="12sp"
      android:textStyle="bold" />

    <ImageView
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:background="@drawable/operarius_widget_plus_bg"
      android:padding="9dp"
      android:src="@drawable/operarius_widget_ic_plus" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingLeft="4dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:text="Thursday"
      android:textColor="#F4F4F6"
      android:textSize="17sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginLeft="7dp"
      android:includeFontPadding="false"
      android:text="September 24"
      android:textColor="#8A8A92"
      android:textSize="12.5sp" />
  </LinearLayout>

  <ProgressBar
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:layout_marginLeft="4dp"
    android:layout_marginTop="9dp"
    android:layout_marginRight="4dp"
    android:max="100"
    android:progress="38"
    android:progressDrawable="@drawable/operarius_widget_progress" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="vertical">

    <!-- A task on the timeline: 56 dp, so the now line can cross it where the moment is. -->
<FrameLayout
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingTop="3dp"
