          android:singleLine="true"
          android:text="09:30 – 11:00 · 1h 30m"
          android:textColor="#8A8A92"
          android:textSize="11.5sp" />
      </LinearLayout>

      <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="11dp">

        <ImageView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:src="@drawable/operarius_widget_ic_ring"
          android:tint="#5B5B63" />

        <ImageView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:src="@drawable/operarius_widget_ic_tick"
          android:visibility="gone" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="26dp"
    android:layout_marginLeft="42dp"
    android:background="@drawable/operarius_widget_tl_elapsed" />

  <FrameLayout
  android:layout_width="match_parent"
  android:layout_height="18dp"
  android:layout_marginTop="17dp">

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="1.5dp"
    android:layout_gravity="center_vertical"
    android:layout_marginRight="2dp"
    android:background="#CCFF5A5F" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- (the time sits at the line's start, over it, as in the app) -->
    <FrameLayout
      android:layout_width="42dp"
      android:layout_height="match_parent">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/operarius_widget_tl_clock"
        android:includeFontPadding="false"
        android:paddingLeft="3dp"
        android:paddingTop="1.5dp"
        android:paddingRight="3dp"
        android:paddingBottom="1.5dp"
        android:textColor="#FF5A5F"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:text="10:05" />
    </FrameLayout>

    <ImageView
      android:layout_width="9dp"
      android:layout_height="9dp"
      android:layout_marginLeft="10.5dp"
      android:src="@drawable/operarius_widget_tl_dot" />
  </LinearLayout>
</FrameLayout>
</FrameLayout>

