<?xml version="1.0" encoding="utf-8"?>
<!-- The Month widget: its header (the month, back to today, the arrows) over
     the generated grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/m_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/operarius_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/m_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/m_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="#F4F4F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/m_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="#8A8A92"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/m_today"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/operarius_widget_pill"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/operarius_widget_today"
            android:textColor="#4FD1C5"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/m_prev"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/operarius_widget_round"
            android:contentDescription="@string/operarius_widget_prev"
            android:padding="7dp"
            android:src="@drawable/operarius_widget_ic_prev" />

        <ImageView
            android:id="@+id/m_next"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/operarius_widget_round"
            android:contentDescription="@string/operarius_widget_next"
            android:padding="7dp"
            android:src="@drawable/operarius_widget_ic_next" />
    </LinearLayout>

    <include
        layout="@layout/operarius_widget_month_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
